# Copia este archivo como .env (desarrollo) y rellena los valores.
# En Vercel, estas mismas variables se configuran en Settings → Environment Variables.
# NUNCA subas el archivo .env a GitHub (ya está en .gitignore).

# --- Base de datos (PostgreSQL en Neon) ---
# Conexión "pooled" (el host contiene -pooler). La usa la app en cada petición.
DATABASE_URL="postgresql://usuario:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"
# Conexión directa (mismo host SIN -pooler). La usa Prisma para las migraciones.
DIRECT_URL="postgresql://usuario:password@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# --- Seguridad ---
# Firma las cookies de sesión y los hashes de los códigos. Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Si lo cambias, todas las sesiones y TODOS los códigos ya enviados dejan de funcionar.
AUTH_SECRET=""
# Contraseña del panel /admin (mínimo 12 caracteres).
ADMIN_PASSWORD=""

# --- URL pública del sitio (se usa en los enlaces de los correos) ---
APP_URL="http://localhost:3000"

# --- Correo (Resend) ---
# Sin RESEND_API_KEY, en desarrollo los correos se imprimen en la terminal (no se envían).
RESEND_API_KEY=""
# Remitente. Para usar tu dominio (drops@hostil.co) primero verifícalo en Resend.
EMAIL_FROM="HOSTIL <onboarding@resend.dev>"

# --- Solo para `pnpm db:seed` (opcional) ---
SEED_USER_EMAIL=""
